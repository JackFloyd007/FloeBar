    "Event delivery could not be confirmed. The current available order is shown; drag again when ready.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zustellung der Eingabeereignisse konnte nicht bestätigt werden. Die aktuell verfügbare Reihenfolge wird angezeigt; ziehe erneut, wenn du bereit bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event delivery could not be confirmed. The current available order is shown; drag again when ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la entrega de eventos. Se muestra el orden disponible actual; vuelve a arrastrar cuando estés listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi des événements n’a pas pu être confirmé. L’ordre actuellement disponible est affiché ; faites glisser à nouveau lorsque vous êtes prêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力イベントの送信を確認できませんでした。現在取得できる順序を表示しています。準備ができたら再度ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 이벤트 전달을 확인할 수 없습니다. 현재 확인 가능한 순서가 표시됩니다. 준비되면 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a entrega dos eventos. A ordem disponível atual é exibida; arraste novamente quando estiver pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认输入事件已送达。现显示当前可用顺序；准备好后请重新拖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認輸入事件已送達。現顯示目前可用順序；準備好後請重新拖移。"
          }
        }
      }
    },
