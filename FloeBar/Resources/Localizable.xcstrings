    "Screen Recording permission is required only for icon previews.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Recording permission is required only for icon previews."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅图标预览需要屏幕录制权限，仍可使用应用图标排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有圖示預覽需要螢幕錄製權限，仍可使用應用程式圖示排序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の権限が必要なのはアイコンのプレビューのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 기록 권한은 아이콘 미리보기에만 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmaufnahmeberechtigung ist nur für Symbolvorschauen nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation d’enregistrement de l’écran est nécessaire uniquement pour les aperçus des icônes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de grabación de pantalla solo se necesita para las vistas previas de los iconos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de gravação de tela só é necessária para as prévias dos ícones."
          }
        }
      }
    },
    "Scroll or swipe in the menu bar to show hidden menu bar items.": {
