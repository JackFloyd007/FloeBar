          "stringUnit": {
            "state": "translated",
            "value": "顯示器已變更。請在目前顯示器再次拖移。"
          }
        }
      }
    },
    "Display images of individual menu bar items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder einzelner Menüleistenobjekte anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display images of individual menu bar items."
          }
        },
        "es": {
