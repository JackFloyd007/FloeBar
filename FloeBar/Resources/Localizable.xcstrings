    "Right-click in an empty area of the menu bar to display a minimal version of FloeBar's menu. Disable this setting if you encounter conflicts with other apps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechtsklick auf einen freien Menüleistenbereich öffnet ein vereinfachtes Menü. Bei Konflikten mit anderen Apps deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click in an empty area of the menu bar to display a minimal version of FloeBar's menu. Disable this setting if you encounter conflicts with other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic derecho en un área vacía para mostrar un menú simplificado. Desactívalo si entra en conflicto con otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic droit sur une zone vide affiche un menu simplifié. Désactivez cette option en cas de conflit avec d’autres apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空白部分を右クリックすると簡易メニューが表示されます。他のアプリと競合する場合は無効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 영역을 오른쪽 클릭하면 간소화된 메뉴가 표시됩니다. 다른 앱과 충돌하면 이 설정을 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em uma área vazia para mostrar um menu simplificado. Desative em caso de conflito com outros apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击菜单栏空白处显示精简菜单。如与其他应用冲突，请关闭此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列空白處按右鍵以顯示精簡選單。如與其他 App 衝突，請關閉此設定。"
          }
        }
      }
    },
