    "Stopped because mouse or keyboard input was detected. The current available order is shown; drag again when input is idle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegen Maus- oder Tastatureingabe angehalten. Die aktuell verfügbare Reihenfolge wird angezeigt. Ziehe erneut, sobald keine Eingabe erfolgt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped because mouse or keyboard input was detected. The current available order is shown; drag again when input is idle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido al detectar entrada del ratón o teclado. Se muestra el orden disponible actual; vuelve a arrastrar cuando no haya entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt après détection d’une saisie clavier ou souris. L’ordre actuellement disponible est affiché ; faites glisser à nouveau lorsque la saisie est terminée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスまたはキーボード入力を検出したため停止しました。現在取得できる順序を表示しています。入力を止めてから再度ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 또는 키보드 입력이 감지되어 중단했습니다. 현재 확인 가능한 순서가 표시됩니다. 입력을 멈춘 후 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido ao detectar entrada do mouse ou teclado. A ordem disponível atual é exibida; arraste novamente quando não houver entrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到鼠标或键盘输入，已中止。现显示当前可用顺序；请停止输入后重新拖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到滑鼠或鍵盤輸入，已中止。現顯示目前可用順序；請停止輸入後重新拖移。"
          }
        }
      }
    },
