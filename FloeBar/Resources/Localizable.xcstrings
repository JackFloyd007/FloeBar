          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans une zone vide de la barre pour afficher les éléments masqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの空白部分をクリックして非表示項目を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대의 빈 영역을 클릭하여 숨긴 항목을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em uma área vazia da barra para mostrar os itens ocultos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击菜单栏空白处显示隐藏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下選單列空白處顯示隱藏項目。"
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access FloeBar settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
