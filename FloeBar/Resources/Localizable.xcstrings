    "Cancelled because the active display changed. The current available order is shown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegen eines Wechsels des aktiven Displays abgebrochen. Die aktuell verfügbare Reihenfolge wird angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled because the active display changed. The current available order is shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado porque cambió la pantalla activa. Se muestra el orden disponible actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé après le changement d’écran actif. L’ordre actuellement disponible est affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作対象のディスプレイが変わったためキャンセルしました。現在取得できる順序を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 디스플레이가 변경되어 취소했습니다. 현재 확인 가능한 순서가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado porque a tela ativa mudou. A ordem disponível atual é exibida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动显示器已切换，操作已取消。现显示当前可用顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作用中的顯示器已切換，操作已取消。現顯示目前可用順序。"
          }
        }
      }
    },
    "Cancelled because the hiding mode changed. The current available order is shown.": {
