        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용도를 알 수 없습니다. 항목 번호는 현재 앱 세션에서만 유효합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalidade desconhecida. Os números dos itens se aplicam apenas à sessão atual do aplicativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定用途。项目编号仅在当前应用会话中有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
