          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao ocultar — verifique a acessibilidade"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏失败，请检查辅助功能权限并重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏失敗，請檢查輔助使用權限並重試"
          }
        }
      }
    },
    "Hiding mode changed. Drag again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblendmodus geändert. Ziehe erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding mode changed. Drag again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de ocultación cambió. Arrastra de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode de masquage a changé. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示モードが変わりました。もう一度ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨김 모드가 변경되었습니다. 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
