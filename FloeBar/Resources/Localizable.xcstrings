    "Make more room in the menu bar by hiding the current app menus if needed. macOS requires FloeBar to make itself visible in the Dock while this setting is in effect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Bedarf App-Menüs ausblenden, um Platz zu schaffen. macOS verlangt dabei, dass FloeBar im Dock sichtbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make more room in the menu bar by hiding the current app menus if needed. macOS requires FloeBar to make itself visible in the Dock while this setting is in effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los menús de la app si hace falta espacio. macOS requiere que FloeBar aparezca en el Dock mientras este ajuste esté activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez les menus de l’app si nécessaire pour gagner de la place. macOS exige alors que FloeBar soit visible dans le Dock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じてアプリメニューを隠して空間を確保します。有効時は macOS の制約により FloeBar が Dock に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요시 현재 앱 메뉴를 숨겨 공간을 확보합니다. 이 설정이 적용되는 동안 macOS 요구 사항에 따라 FloeBar가 Dock에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte os menus do app quando necessário para liberar espaço. O macOS exige que o FloeBar apareça no Dock enquanto este ajuste estiver ativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必要时隐藏当前应用菜单以腾出空间。此功能生效时，macOS 要求 FloeBar 显示在程序坞中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必要時隱藏目前 App 選單以騰出空間。此功能生效時，macOS 要求 FloeBar 顯示在 Dock 中。"
          }
        }
      }
    },
