    "Normal mode supports reordering only. macOS controls overflow; individual hiding is unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im normalen Modus ist nur Umordnen möglich. macOS steuert den Überlauf; einzelne Objekte lassen sich nicht ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal mode supports reordering only. macOS controls overflow; individual hiding is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo normal solo permite reordenar. macOS controla el desbordamiento; no se pueden ocultar elementos individualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode normal permet uniquement de réordonner. macOS gère le débordement ; le masquage individuel est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常モードでは並べ替えのみ可能です。オーバーフローは macOS が管理し、個別には非表示にできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 모드에서는 순서만 변경할 수 있습니다. 넘침 영역은 macOS가 관리하며 개별 항목은 숨길 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo normal permite apenas reordenar. O macOS controla a área de excedentes; não é possível ocultar itens individualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通模式仅支持调整顺序。溢出区由 macOS 控制，无法指定单个项目隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般模式僅支援調整順序。溢出區由 macOS 控制，無法指定單一項目隱藏。"
          }
        }
      }
    },
    "Normal mode uses macOS overflow. Sections apply only to experimental private hiding.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der normale Modus nutzt den macOS-Überlauf. Bereiche gelten nur für experimentelles privates Ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal mode uses macOS overflow. Sections apply only to experimental private hiding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo normal usa el desbordamiento de macOS. Las secciones solo se aplican a la ocultación privada experimental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode normal utilise le débordement de macOS. Les sections concernent uniquement le masquage privé expérimental."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常モードはmacOSの展開機能を使用します。区分設定は実験的な非公開APIモード専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 모드는 macOS 확장 영역을 사용합니다. 구역 설정은 실험적 비공개 숨김에만 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo normal usa a expansão do macOS. As seções se aplicam apenas à ocultação privada experimental."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通模式使用 macOS 系统溢出区。分区设置仅用于实验性私有隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般模式使用 macOS 系統溢出區。分區設定僅用於實驗性私有隱藏。"
          }
        }
      }
    },
