    "Physical menu bar visibility is not automatically checked.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Physical menu bar visibility is not automatically checked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不会自动核验菜单栏图标的实际可见性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不會自動核驗選單列圖示的實際可見性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー項目の実際の表示状態は自動確認されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 항목의 실제 표시 상태는 자동으로 확인되지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die tatsächliche Sichtbarkeit in der Menüleiste wird nicht automatisch geprüft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La visibilité réelle dans la barre des menus n’est pas vérifiée automatiquement."
          }
        },
        "es": {
