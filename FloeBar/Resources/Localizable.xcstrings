    "Input interrupted the move. Release the mouse and modifier keys, then drag again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingabe hat das Verschieben unterbrochen. Lass Maus und Sondertasten los und ziehe erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input interrupted the move. Release the mouse and modifier keys, then drag again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una entrada interrumpió el movimiento. Suelta el ratón y las teclas modificadoras y arrastra de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entrée a interrompu le déplacement. Relâchez la souris et les touches de modification, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力により移動を中断しました。マウスと修飾キーを放してから再度ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력으로 이동이 중단되었습니다. 마우스와 보조 키를 놓은 후 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma entrada interrompeu o movimento. Solte o mouse e as teclas modificadoras e arraste novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入中断了移动。请松开鼠标和修饰键，再次拖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入中斷了移動。請放開滑鼠和修飾鍵，再次拖移。"
          }
        }
      }
    },
