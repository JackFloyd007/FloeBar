    "Application changes need recovery. Restore applications before editing the selection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwendungsänderungen müssen wiederhergestellt werden. Stelle die Anwendungen wieder her, bevor du die Auswahl änderst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application changes need recovery. Restore applications before editing the selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de aplicaciones necesitan restaurarse. Restaura las aplicaciones antes de editar la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications des applications doivent être restaurées. Restaurez les applications avant de modifier la sélection."
          }
