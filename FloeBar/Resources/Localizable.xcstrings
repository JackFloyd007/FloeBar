    "Use the FloeBar arrow to expand or collapse the applications selected in Menu Bar Layout.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the FloeBar arrow to expand or collapse the applications selected in Menu Bar Layout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 FloeBar 箭头展开或收起“菜单栏布局”中选择的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 FloeBar 箭頭展開或收合「選單列佈局」中選擇的應用程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar の矢印で、「メニューバーの配置」で選択したアプリを展開・折りたたみできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar 화살표로 메뉴 막대 레이아웃에서 선택한 앱을 펼치거나 접으세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende die unter „Menüleistenlayout“ ausgewählten Apps mit dem FloeBar-Pfeil ein oder aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la flèche FloeBar pour afficher ou masquer les apps choisies dans la disposition de la barre des menus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la flecha de FloeBar para mostrar u ocultar las apps seleccionadas en la distribución de la barra de menús."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a seta do FloeBar para mostrar ou ocultar os apps selecionados no layout da barra de menus."
          }
        }
      }
    },
