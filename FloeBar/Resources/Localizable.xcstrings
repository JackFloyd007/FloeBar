    "Drag items between sections, or change their order. Changes appear in your menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte zwischen Bereichen ziehen oder ihre Reihenfolge ändern. Änderungen erscheinen in der Menüleiste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag items between sections, or change their order. Changes appear in your menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra elementos entre secciones o cambia su orden. Los cambios se reflejan en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez les éléments entre les sections ou modifiez leur ordre. Les changements apparaissent dans la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目をドラッグしてセクションや順序を変更すると、メニューバーに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 드래그하여 구역이나 순서를 바꾸면 메뉴 막대에 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste itens entre seções ou altere sua ordem. As alterações aparecem na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动项目调整分区或顺序，更改将应用到菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移項目以調整分區或順序，變更會套用至選單列。"
          }
        }
      }
    },
