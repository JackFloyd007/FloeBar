    },
    "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reagiert nicht und kann erst nach einem Neustart verschoben werden. Auch andere Menüleistenobjekte können betroffen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is unresponsive. Until it is restarted, it cannot be moved. Movement of other menu bar items may also be affected until this is resolved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no responde. Reinícialo para poder moverlo. También puede afectar al movimiento de otros elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne répond pas. Redémarrez-le avant de le déplacer. Le déplacement des autres éléments peut aussi être affecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が応答していません。再起動するまで移動できず、他の項目にも影響する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 응답하지 않습니다. 재시작 전에는 이동할 수 없으며 다른 항목 이동에도 영향을 줄 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não responde. Reinicie-o para poder movê-lo. A movimentação de outros itens também pode ser afetada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无响应，重新启动后才能移动。其他菜单栏项目的移动也可能受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回應，重新啟動後才能移動。其他選單列項目的移動也可能受到影響。"
          }
        }
      }
    },
