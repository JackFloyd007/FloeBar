{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not movable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ lässt sich nicht verschieben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not movable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no se puede mover"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne peut pas être déplacé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は移動できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 이동할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não pode ser movido"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无法移动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法移動"
          }
        }
      }
    },
    "\"%@\" took too long to respond": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat zu lange für die Antwort benötigt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" took too long to respond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tardó demasiado en responder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a mis trop de temps à répondre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」の応答がタイムアウトしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 응답 시간 초과"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” demorou muito para responder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”响应超时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」回應逾時"
          }
        }
      }
    },
