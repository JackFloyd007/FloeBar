          }
        }
      }
    },
    "Hiding unsupported: system item or unverified owner. Reordering is still available.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden nicht unterstützt: Systemobjekt oder ungeprüfter Eigentümer. Umordnen bleibt möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding unsupported: system item or unverified owner. Reordering is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede ocultar: elemento del sistema o propietario sin verificar. Se puede cambiar el orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquage non pris en charge : élément système ou propriétaire non vérifié. Le réordonnancement reste possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示には未対応です。システム項目または所有元が未確認です。並べ替えは可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 항목이거나 소유 앱이 확인되지 않아 숨길 수 없습니다. 순서는 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ocultar: item do sistema ou proprietário não verificado. Ainda é possível reordenar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持隐藏：系统项目或归属尚未验证。仍可调整顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援隱藏：系統項目或歸屬尚未驗證。仍可調整順序。"
          }
        }
      }
    },
    "Historical assignments are kept for experimental private hiding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisherige Zuordnungen bleiben für das experimentelle private Ausblenden erhalten."
          }
