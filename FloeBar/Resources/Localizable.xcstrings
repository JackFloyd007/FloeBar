    "Absolutely no personal information is collected or stored.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine persönlichen Daten erfasst oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutely no personal information is collected or stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recopila ni almacena información personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information personnelle n’est collectée ni stockée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報は一切収集・保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 정보를 수집하거나 저장하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma informação pessoal é coletada ou armazenada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会收集或存储任何个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會蒐集或儲存任何個人資訊。"
          }
        }
      }
    },
