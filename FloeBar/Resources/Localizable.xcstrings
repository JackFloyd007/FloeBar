    "%lld applications selected · %lld unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld applications selected · %lld unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择 %lld 个应用 · %lld 项暂不可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選擇 %lld 個應用程式 · %lld 項暫時無法使用"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアプリ %lld 個・利用不可 %lld 個"
