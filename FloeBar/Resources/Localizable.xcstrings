    "Display changed. Drag again on the current display.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirm geändert. Ziehe auf dem aktuellen Bildschirm erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display changed. Drag again on the current display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla cambió. Arrastra de nuevo en la pantalla actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran a changé. Réessayez sur l’écran actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイが変わりました。現在の画面でもう一度ドラッグしてください。"
