    "Click FloeBar to show or hide these items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar anklicken, um diese Objekte ein- oder auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click FloeBar to show or hide these items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en FloeBar para mostrar u ocultar estos elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur FloeBar pour afficher ou masquer ces éléments."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar をクリックして表示・非表示を切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar를 클릭하여 이 항목들을 표시하거나 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no FloeBar para mostrar ou ocultar estes itens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 FloeBar 显示或隐藏这些项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下 FloeBar 顯示或隱藏這些項目。"
          }
        }
      }
    },
    "Click FloeBar to toggle system overflow. Normal mode uses a fixed icon; custom icons apply to experimental mode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf FloeBar, um den Systemüberlauf umzuschalten. Der normale Modus nutzt ein festes Symbol; eigene Symbole gelten im experimentellen Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click FloeBar to toggle system overflow. Normal mode uses a fixed icon; custom icons apply to experimental mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse FloeBar para alternar el desbordamiento del sistema. El modo normal usa un icono fijo; los personalizados se usan en el modo experimental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur FloeBar pour basculer le débordement système. Le mode normal utilise une icône fixe ; les icônes personnalisées concernent le mode expérimental."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBarをクリックするとシステムの隠れた項目を展開・収納します。通常モードは固定アイコン、実験モードはカスタムアイコンを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar를 클릭하면 시스템 숨겨진 항목을 전환합니다. 일반 모드는 고정 아이콘을, 실험 모드는 사용자 지정 아이콘을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no FloeBar para alternar a expansão do sistema. O modo normal usa um ícone fixo; ícones personalizados se aplicam ao modo experimental."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 FloeBar 可展开或收起系统溢出区。普通模式使用固定图标；自定义图标用于实验模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊 FloeBar 可展開或收起系統溢出區。一般模式使用固定圖示；自訂圖示用於實驗模式。"
          }
        }
      }
    },
    "Click inside an empty area of the menu bar to show hidden menu bar items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einen freien Bereich der Menüleiste klicken, um ausgeblendete Objekte anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click inside an empty area of the menu bar to show hidden menu bar items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
