    "All items are temporarily shown while arranging. Close Settings to apply hiding.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anordnen werden alle Objekte vorübergehend angezeigt. Zum Ausblenden Einstellungen schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All items are temporarily shown while arranging. Close Settings to apply hiding."
