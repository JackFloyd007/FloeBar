    "Hiding could not be verified. Items remain visible. Close Settings and click FloeBar to retry; check Accessibility permission if this continues.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden konnte nicht bestätigt werden. Objekte bleiben sichtbar. Einstellungen schließen und FloeBar anklicken. Bei weiteren Fehlern Bedienungshilfen prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding could not be verified. Items remain visible. Close Settings and click FloeBar to retry; check Accessibility permission if this continues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la ocultación. Cierra los ajustes y haz clic en FloeBar para reintentar. Si persiste, comprueba el permiso de accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le masquage n’a pas pu être confirmé. Fermez les réglages et cliquez sur FloeBar pour réessayer. Si le problème persiste, vérifiez l’autorisation d’accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示を確認できないため、項目は表示されたままです。設定を閉じて FloeBar をクリックし再試行してください。続く場合はアクセシビリティの許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨김을 확인하지 못해 항목이 계속 표시됩니다. 설정을 닫고 FloeBar를 클릭하여 다시 시도하세요. 문제가 지속되면 손쉬운 사용 권한을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a ocultação. Feche os ajustes e clique no FloeBar para tentar novamente. Se persistir, verifique a permissão de acessibilidade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认隐藏操作，项目仍然显示。请关闭设置后点击 FloeBar 重试；若仍失败，请检查辅助功能权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認隱藏操作，項目仍然顯示。請關閉設定後按一下 FloeBar 重試；若仍失敗，請檢查輔助使用權限。"
          }
        }
      }
    },
    "Hiding failed — check Accessibility permission and retry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden fehlgeschlagen — Bedienungshilfen prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiding failed — check Accessibility permission and retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al ocultar — comprueba la accesibilidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du masquage — vérifiez l’accessibilité"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示に失敗：アクセシビリティの許可を確認して再試行"
