    "FloeBar uses an arrow for expand/collapse. Application hiding requires access to the system menu bar preferences file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar verwendet einen Pfeil zum Ein- und Ausklappen. Zum Ausblenden von Apps ist Zugriff auf die Systemmenüleisteneinstellungen erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar uses an arrow for expand/collapse. Application hiding requires access to the system menu bar preferences file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar usa una flecha para expandir o contraer. Ocultar aplicaciones requiere acceso a las preferencias de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar utilise une flèche pour développer ou réduire. Le masquage nécessite l’accès aux préférences de la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar は展開・折りたたみに矢印を使用します。アプリの非表示にはシステムメニューバー設定ファイルへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar는 펼침과 접기에 화살표를 사용합니다. 앱 가리기에는 시스템 메뉴 막대 설정 파일 접근이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar usa uma seta para expandir ou recolher. Ocultar aplicativos requer acesso às preferências da barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar 使用箭头表示展开或折叠。按应用隐藏需要访问系统菜单栏偏好文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar 使用箭頭表示展開或收合。依應用程式隱藏需要存取系統選單列偏好檔案。"
          }
        }
      }
    },
