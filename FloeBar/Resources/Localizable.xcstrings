    "Hold ⌘ and drag in the menu bar. Items to the left of FloeBar are hidden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit gedrückter ⌘-Taste in der Menüleiste ziehen. Objekte links von FloeBar werden ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌘ and drag in the menu bar. Items to the left of FloeBar are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ⌘ y arrastra en la barra de menús. Se ocultarán los elementos a la izquierda de FloeBar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ et faites glisser dans la barre des menus. Les éléments à gauche de FloeBar seront masqués."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ を押しながらメニューバーでドラッグします。FloeBar の左側の項目が非表示になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 키를 누른 채 메뉴 막대에서 드래그하세요. FloeBar 왼쪽 항목이 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘ e arraste na barra de menus. Os itens à esquerda do FloeBar serão ocultados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 拖动菜单栏项目。FloeBar 左侧的项目会被隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 拖移選單列項目。FloeBar 左側的項目會被隱藏。"
          }
        }
      }
    },
    "Hold ⌘ and drag to reorder. macOS decides which items fit in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Sortieren mit ⌘ ziehen. macOS entscheidet, welche Symbole in die Menüleiste passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌘ and drag to reorder. macOS decides which items fit in the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga ⌘ y arrastre para ordenar. macOS decide qué elementos caben en la barra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌘ et faites glisser pour réorganiser. macOS décide quels éléments tiennent dans la barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘を押しながらドラッグして並べ替えます。表示できる項目はmacOSが空き領域に応じて決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘를 누른 채 드래그하여 정렬합니다. 표시할 항목은 macOS가 공간에 따라 결정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌘ e arraste para ordenar. O macOS decide quais itens cabem na barra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 拖动可调整顺序。macOS 根据空间决定菜单栏显示哪些项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌘ 拖移可調整順序。macOS 根據空間決定選單列顯示哪些項目。"
          }
        }
      }
