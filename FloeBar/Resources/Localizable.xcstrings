    "macOS overflow is expanded. Drag again to choose a new order.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der macOS-Überlauf ist geöffnet. Ziehe erneut, um eine neue Reihenfolge zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS overflow is expanded. Drag again to choose a new order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desbordamiento de macOS está expandido. Arrastra de nuevo para elegir otro orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le débordement de macOS est développé. Faites glisser à nouveau pour choisir un nouvel ordre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のオーバーフローを展開しました。再度ドラッグして新しい順序を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 오버플로가 펼쳐졌습니다. 다시 드래그하여 새 순서를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O transbordamento do macOS está expandido. Arraste novamente para escolher uma nova ordem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 溢出菜单已展开。请重新拖动以选择新的顺序。"
