    "Select applications for the FloeBar arrow. Hiding affects every menu bar item belonging to each selected application.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select applications for the FloeBar arrow. Hiding affects every menu bar item belonging to each selected application."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择由 FloeBar 箭头控制隐藏的应用。隐藏会影响所选应用的所有菜单栏项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇由 FloeBar 箭頭控制隱藏的應用程式。隱藏會影響所選應用程式的所有選單列項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar の矢印で非表示にするアプリを選択します。各アプリのすべてのメニューバー項目に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FloeBar 화살표로 숨길 앱을 선택하세요. 선택한 앱의 모든 메뉴 막대 항목이 영향을 받습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Apps, die der FloeBar-Pfeil ausblendet. Dies betrifft alle Menüleistenobjekte der ausgewählten Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les apps à masquer avec la flèche FloeBar. Tous les éléments de leur barre des menus sont concernés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona las apps que ocultará la flecha de FloeBar. Afecta a todos los elementos de la barra de menús de cada app seleccionada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione os apps que a seta do FloeBar deve ocultar. Isso afeta todos os itens da barra de menus de cada app selecionado."
          }
        }
      }
    },
    "Selected applications are hidden in the current menu bar.": {
