          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已套用系統隱藏設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの非表示設定を適用しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 숨김 설정이 적용되었습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemeinstellungen zum Ausblenden wurden angewendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages système de masquage ont été appliqués."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha aplicado la configuración del sistema para ocultar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes de ocultação do sistema foram aplicados."
          }
        }
      }
    },
    "System items stay visible; apps split across sections cannot be hidden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemsymbole sind keine Ziele, können aber von privaten APIs betroffen sein. Apps in mehreren Bereichen können nicht ausgeblendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System items are not hide targets, but private APIs may affect them. Apps split across sections cannot be hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos del sistema no son objetivos, pero las API privadas pueden afectarlos. No se pueden ocultar apps repartidas entre secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments système ne sont pas ciblés, mais les API privées peuvent les affecter. Les apps réparties entre sections ne peuvent pas être masquées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム項目は対象外ですが、非公開APIの影響を受ける場合があります。複数の区分にあるアプリは非表示にできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 항목은 숨김 대상이 아니지만 비공개 API의 영향을 받을 수 있습니다. 여러 구역에 걸친 앱은 숨길 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens do sistema não são alvos, mas APIs privadas podem afetá-los. Apps divididos entre seções não podem ser ocultados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统项不作为隐藏目标，但私有接口可能影响系统控件。同一应用跨分区时不能隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統項目不作為隱藏目標，但私有介面可能影響系統控制項。同一應用程式跨分區時不能隱藏。"
          }
        }
      }
    },
    "System overflow unavailable or unconfirmed; use the macOS double-chevron.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemüberlauf nicht verfügbar oder unbestätigt; verwenden Sie den macOS-Doppelpfeil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System overflow unavailable or unconfirmed; use the macOS double-chevron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbordamiento del sistema no disponible o sin confirmar; use la doble flecha de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débordement système indisponible ou non confirmé ; utilisez le double chevron de macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの展開ボタンが見つからないか、操作を確認できません。macOSの二重矢印を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 확장 버튼을 찾지 못했거나 동작을 확인하지 못했습니다. macOS 이중 화살표를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expansão do sistema indisponível ou não confirmada; use a seta dupla do macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到系统溢出按钮或操作未确认；请使用 macOS 双箭头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到系統溢出按鈕或操作未確認；請使用 macOS 雙箭頭。"
