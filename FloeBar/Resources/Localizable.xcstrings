            "value": "Nach dem Start der Menüleisten-Apps erneut versuchen. Berechtigungen unter Erweitert prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again once your menu bar apps are ready. You can check permissions in Advanced Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintenta cuando las apps estén listas. Puedes comprobar los permisos en los ajustes avanzados."
