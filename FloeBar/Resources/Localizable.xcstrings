            "value": "Das Öffnen der Elemente konnte nicht bestätigt werden. Öffne den macOS-Überlauf manuell und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm expanded items. Open macOS overflow manually, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar que los elementos se expandieran. Abre el desbordamiento de macOS manualmente e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
