            "value": "Mostrar imágenes de cada elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les images de chaque élément."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メニューバー項目の画像を表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 메뉴 막대 항목의 이미지 표시."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibir imagens de cada item da barra."
          }
        },
        "zh-Hans": {
