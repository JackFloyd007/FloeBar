          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonction inconnue. Les numéros des éléments s’appliquent uniquement à la session actuelle de l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用途は不明です。項目番号は現在のアプリセッション内でのみ有効です。"
          }
