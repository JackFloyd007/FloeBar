    "A menu bar item is temporarily unavailable. Expand macOS overflow if needed, then drag again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Menüleistenelement ist vorübergehend nicht verfügbar. Öffne bei Bedarf den macOS-Überlauf und ziehe erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu bar item is temporarily unavailable. Expand macOS overflow if needed, then drag again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un elemento no está disponible temporalmente. Expande el desbordamiento de macOS si es necesario y vuelve a arrastrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément est temporairement indisponible. Développez le débordement de macOS si nécessaire, puis faites glisser à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーの項目を一時的に取得できません。必要に応じて macOS のオーバーフローを展開してから再度ドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 메뉴 막대 항목을 일시적으로 사용할 수 없습니다. 필요한 경우 macOS 오버플로를 펼친 후 다시 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um item está temporariamente indisponível. Expanda o transbordamento do macOS se necessário e arraste novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个菜单栏项目暂不可用。如有需要，请先展开 macOS 溢出菜单，再重新拖动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個選單列項目暫時無法使用。如有需要，請先展開 macOS 溢出選單，再重新拖移。"
          }
        }
      }
    },
