            "value": "Les affectations précédentes sont conservées pour le masquage privé expérimental."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の割り当ては実験用の非公開非表示機能のために保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
