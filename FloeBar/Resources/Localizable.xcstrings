    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellung startet alle Apps mit Menüleistenobjekten neu. Einige müssen manuell neu gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste reinicia todas las apps de la barra. Algunas deben reiniciarse manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réglage relance toutes les apps de la barre. Certaines devront être relancées manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用するとメニューバーのアプリが再起動します。一部は手動での再起動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하면 메뉴 막대 앱이 모두 재실행됩니다. 일부 앱은 수동으로 재실행해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ajuste reinicia todos os apps da barra. Alguns precisam ser reiniciados manualmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用此设置会重新启动所有菜单栏应用，部分应用可能需要手动重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "套用此設定會重新啟動所有選單列 App，部分 App 可能需要手動重新啟動。"
          }
        }
      }
    },
