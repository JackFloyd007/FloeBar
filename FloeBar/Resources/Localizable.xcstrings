        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los elementos se muestran temporalmente al organizarlos. Cierra los ajustes para ocultarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les éléments sont visibles pendant l’organisation. Fermez les réglages pour les masquer."
